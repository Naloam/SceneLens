# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios

# Claude AI artifacts
.claude/
*.claude.*

# Documentation files (except README)
*.md
!README.md
docs/
**/*.README.md
**/*.demo.ts
**/*.SUMMARY.md

# Windows special files
**/nul

# Android crash / profiling artifacts (JVM fatal-error logs, JFR replay logs)
android/hs_err_pid*.log
android/replay_pid*.log

# local debugging dumps (adb UI dumps, scratch jest output, temp notes)
/window_dump*.xml
/tmp_jest_results.json
/TempLog.md

# other
*.png